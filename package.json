{
	"name": "telecat",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@10.18.1",
	"description": "Open Source Teleprompter App",
	"author": "MarcusUniverse",
	"license": "MIT",
	"engines": {
		"node": ">=23"
	},
	"scripts": {
		"dev": "concurrently -n nuxt,server -c blue,green \"nuxt dev\" \"tsx watch server/index.ts\"",
		"dev:server": "tsx watch server/index.ts",
		"start:server": "tsx server/index.ts",
		"generate": "nuxt generate",
		"preinstall": "npx only-allow pnpm",
		"postinstall": "nuxt prepare",
		"lint": "eslint . --fix",
		"bump": "bumpp",
		"tauri": "tauri",
		"deploy": "gh-pages -d .output/public",
		"tauri:dev": "tauri dev",
		"tauri:build": "npm run prebuild && tauri build && npm run postbuild",
		"tauri:build:debug": "tauri build --debug",
		"prebuild": "node scripts/prebuild.js",
		"postbuild": "node scripts/postbuild.js",
		"npm_patch": "npm version patch --no-git-tag-version",
		"npm_major": "npm version major --no-git-tag-version",
		"npm_minor": "npm version minor --no-git-tag-version"
	},
	"dependencies": {
		"@antfu/utils": "^9.3.0",
		"@hocuspocus/extension-logger": "^3.2.5",
		"@hocuspocus/extension-redis": "3.2.5",
		"@hocuspocus/extension-sqlite": "3.2.5",
		"@hocuspocus/extension-webhook": "3.2.5",
		"@hocuspocus/provider": "^3.2.5",
		"@hocuspocus/server": "^3.2.5",
		"@hocuspocus/transformer": "3.2.5",
		"@nuxtjs/device": "3.2.4",
		"@nuxtjs/i18n": "^10.4.1",
		"@pdf-lib/fontkit": "^1.1.1",
		"@pinia/nuxt": "^0.11.2",
		"@tauri-apps/api": "^2.8.0",
		"@tauri-apps/plugin-dialog": "~2.4.0",
		"@tauri-apps/plugin-fs": "^2.4.2",
		"@tauri-apps/plugin-notification": "^2.3.1",
		"@tauri-apps/plugin-os": "^2.3.1",
		"@tauri-apps/plugin-shell": "^2.3.1",
		"@tauri-apps/plugin-store": "^2.4.0",
		"@tiptap/core": "^3.6.5",
		"@tiptap/extension-collaboration": "^3.6.5",
		"@tiptap/extension-document": "^3.6.5",
		"@tiptap/extension-highlight": "^3.6.5",
		"@tiptap/extension-image": "^3.6.5",
		"@tiptap/extension-link": "^3.6.5",
		"@tiptap/extension-paragraph": "^3.6.5",
		"@tiptap/extension-text": "^3.6.5",
		"@tiptap/extensions": "^3.6.5",
		"@tiptap/pm": "^3.6.5",
		"@tiptap/starter-kit": "^3.6.5",
		"@tiptap/vue-3": "^3.6.5",
		"docx": "^9.5.1",
		"express": "^5.1.0",
		"express-ws": "^5.0.2",
		"fflate": "^0.8.2",
		"html-docx": "^1.2.0",
		"marked": "^16.4.0",
		"nuxt": "^4.1.3",
		"pdf-lib": "^1.17.1",
		"pinia": "^3.0.3",
		"tiptap-markdown": "^0.9.0",
		"tsx": "^4.23.1",
		"vue": "^3.5.22",
		"vue-router": "^4.5.1",
		"y-indexeddb": "^9.0.12",
		"y-prosemirror": "^1.3.7",
		"y-webrtc": "^10.3.0",
		"yjs": "^13.6.27",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@nuxt/eslint": "^1.9.0",
		"@nuxt/types": "^2.18.1",
		"@tauri-apps/cli": "^2.8.4",
		"@types/express": "^5.0.3",
		"@types/express-ws": "^3.0.5",
		"@types/node": "^24.7.0",
		"@vueuse/core": "^13.9.0",
		"@vueuse/nuxt": "^13.9.0",
		"baseline-browser-mapping": "^2.10.43",
		"bumpp": "^10.3.1",
		"concurrently": "^10.0.3",
		"eslint": "9.37.0",
		"gh-pages": "^6.3.0",
		"kill-port": "^2.0.1",
		"nuxt-svgo": "^4.2.6",
		"sass": "^1.93.2",
		"typescript": "^5.9.3"
	}
}
