{
	"name": "telecat",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@10.18.0",
	"description": "Open Source Teleprompter App",
	"author": "MarcusUniverse",
	"license": "MIT",
	"engines": {
		"node": ">=23"
	},
	"scripts": {
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preinstall": "npx only-allow pnpm",
		"postinstall": "nuxt prepare",
		"lint": "eslint . --fix",
		"bump": "bumpp",
		"tauri": "tauri",
		"deploy": "gh-pages -d .output/public",
		"tauri:dev": "tauri dev",
		"tauri:build": "npm run prebuild && tauri build && npm run postbuild",
		"tauri:build:debug": "tauri build --debug",
		"prebuild": "node scripts/prebuild.js",
		"postbuild": "node scripts/postbuild.js",
		"npm_patch": "npm version patch --no-git-tag-version",
		"npm_major": "npm version major --no-git-tag-version",
		"npm_minor": "npm version minor --no-git-tag-version"
	},
	"dependencies": {
		"@antfu/utils": "^9.3.0",
		"@hocuspocus/extension-logger": "^2.15.3",
		"@hocuspocus/extension-redis": "3.0.6-rc.0",
		"@hocuspocus/extension-sqlite": "3.0.6-rc.0",
		"@hocuspocus/extension-webhook": "3.0.6-rc.0",
		"@hocuspocus/provider": "^2.15.3",
		"@hocuspocus/server": "^2.15.3",
		"@hocuspocus/transformer": "3.0.6-rc.0",
		"@nuxtjs/device": "3.2.4",
		"@pinia/nuxt": "^0.10.1",
		"@tauri-apps/api": "^2.8.0",
		"@tauri-apps/plugin-fs": "^2.4.2",
		"@tauri-apps/plugin-notification": "^2.3.1",
		"@tauri-apps/plugin-os": "^2.3.1",
		"@tauri-apps/plugin-shell": "^2.3.1",
		"@tauri-apps/plugin-store": "^2.4.0",
		"@tiptap/core": "^2.26.2",
		"@tiptap/extension-collaboration": "^2.26.2",
		"@tiptap/extension-highlight": "^2.26.2",
		"@tiptap/pm": "^2.26.2",
		"@tiptap/starter-kit": "^2.26.1",
		"@tiptap/vue-3": "^2.26.2",
		"express": "^4.21.2",
		"express-ws": "^5.0.2",
		"marked": "^15.0.12",
		"nuxt": "^3.19.3",
		"pinia": "^3.0.3",
		"tiptap-markdown": "^0.8.10",
		"vue": "^3.5.22",
		"vue-router": "^4.5.1",
		"y-indexeddb": "^9.0.12",
		"y-prosemirror": "^1.3.7",
		"y-webrtc": "^10.3.0",
		"yjs": "^13.6.27",
		"zod": "^3.25.76"
