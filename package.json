		"@antfu/eslint-config": "^4.19.0",
		"@nuxt/eslint": "^1.9.0",
		"@nuxt/types": "^2.18.1",
		"@tauri-apps/cli": "^2.8.4",
		"@types/express": "^5.0.3",
		"@types/express-ws": "^3.0.5",
		"@types/node": "^22.18.8",
		"@vueuse/core": "^12.8.2",
		"@vueuse/nuxt": "^12.8.2",
		"bumpp": "^10.3.1",
		"eslint": "9.17.0",
		"gh-pages": "^6.3.0",
		"kill-port": "^2.0.1",
		"nuxt-svgo": "^4.2.6",
		"sass": "^1.93.2",
